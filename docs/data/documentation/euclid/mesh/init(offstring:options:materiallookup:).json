      "parameters" : [
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "OFF string data, including C, N and ST header variants for vertex colors,",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "normals and two-dimensional texture coordinates. Face RGB(A) accepts integers in 0 … 255",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "or floating-point values in 0 … 1; COFF vertices use floating-point RGBA in 0 … 1.",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "RGB values are treated as sRGB without gamma conversion. Palette indices are ignored.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "offString"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "The import options.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "options"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "Maps face colors to materials. If omitted, face colors become materials.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "materialLookup"
        }
