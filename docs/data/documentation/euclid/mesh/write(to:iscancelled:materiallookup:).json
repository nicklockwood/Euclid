          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Uses native writers for STL, OFF and ASCII PLY, then prefers SceneKit for other formats.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Falls back to Model I\/O if SceneKit is unavailable or cannot export the file.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Platform exports accept ",
              "type" : "text"
            },
            {
              "code" : "MDLMaterial",
              "type" : "codeVoice"
            },
            {
              "text" : ", ",
              "type" : "text"
            },
            {
              "code" : "SCNMaterial",
              "type" : "codeVoice"
            },
            {
              "text" : ", color and image materials.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Format capabilities vary;",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "not all exporters preserve vertex colors, alpha or textures.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
