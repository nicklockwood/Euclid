          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Preserves vertex positions, normals, UV coordinates and sRGB vertex colors.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Byte RGB and alpha components are normalized to 0…1. Floating-point components",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "are used directly. Common ",
              "type" : "text"
            },
            {
              "code" : "diffuse_red",
              "type" : "codeVoice"
            },
            {
              "text" : ", ",
              "type" : "text"
            },
            {
              "code" : "diffuse_green",
              "type" : "codeVoice"
            },
            {
              "text" : ", ",
              "type" : "text"
            },
            {
              "code" : "diffuse_blue",
              "type" : "codeVoice"
            },
            {
              "text" : " and",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "code" : "diffuse_alpha",
              "type" : "codeVoice"
            },
            {
              "text" : " properties are also supported. Unknown elements and properties are skipped.",
              "type" : "text"
            }
          ],
