# file options

--exclude Build, Tests/XCTestManifests.swift

# format options

--swiftversion 5.10
--hexgrouping ignore
--decimalgrouping ignore
--ifdef no-indent
--self init-only
--shortoptionals except-properties
--wraparguments before-first
--wrapcollections before-first
--wrapconditions after-first
--maxwidth 120

# rules

--lint-only unusedArguments
--lint-only unusedPrivateDeclarations
--enable emptyExtensions
--enable isEmpty
--enable preferFinalClasses
--disable docComments
--disable wrapFunctionBodies
--disable wrapPropertyBodies
--disable wrapIfStatementBodies
